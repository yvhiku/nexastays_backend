# Real production SHARED env — copy to deploy/.env (chmod 600). Never commit secrets.
# Also require .env.identity and .env.stays (separate DB credentials).
#
# STAYS_PAYMENT_PROVIDER=mock is REJECTED when NEXA_ENV=production.
# Soft-launch / dogfood must use NEXA_ENV=dogfood instead.
# Production requires STAYS_PAYMENT_PROVIDER=cmi + CMI secrets (no silent mock fallback).
# SUMSUB_MODE=live and EMI_PROVIDER_TYPE=disabled|real required (no silent sandbox/mock).

NEXA_ENV=production
NODE_ENV=production
IMAGE_REGISTRY=ghcr.io/REPLACE_OWNER
BACKEND_IMAGE_TAG=REPLACE_BACKEND_GIT_SHA
WEB_IMAGE_TAG=REPLACE_WEB_GIT_SHA
DASHBOARD_IMAGE_TAG=REPLACE_DASHBOARD_GIT_SHA

IDENTITY_HOST_PORT=3001
STAYS_HOST_PORT=3002

IDENTITY_DATABASE_URL=postgresql://nexa_identity:REPLACE@127.0.0.1:5433/nexa_identity
STAYS_DATABASE_URL=postgresql://nexa_stays:REPLACE@127.0.0.1:5434/nexa_stays

DB_SYNCHRONIZE=false
DB_SSL=true
# Prefer DB_SSL_REJECT_UNAUTHORIZED=true with real CA-backed Postgres TLS in production.
DB_SSL_REJECT_UNAUTHORIZED=true

PII_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTE_KEY
JWT_PRIVATE_KEY=REPLACE_PEM
JWT_PUBLIC_KEY=REPLACE_PEM
JWT_KEY_ID=nexa-identity-1
JWT_ISSUER=https://identity.example/api/v1
JWT_AUDIENCE=nexa-platform
REFRESH_TOKEN_PEPPER=REPLACE
OTP_PEPPER=REPLACE
KYC_HASH_PEPPER=REPLACE
ADMIN_PASSWORD_HASH=REPLACE_ARGON2ID
INTERNAL_SERVICE_KEY=REPLACE
CORS_ORIGINS=https://nexastays.example,https://admin.nexastays.example
AUTH_COOKIE_DOMAIN=.nexastays.example

# SMS — prefer EnvoiSMS for Morocco (+212). Twilio remains a fallback.
SMS_PROVIDER=envoisms
ENVOISMS_API_KEY=REPLACE
ENVOISMS_BASE_URL=https://api.envoisms.ma
# ENVOISMS_FROM=NexaStays
# TWILIO_ACCOUNT_SID=REPLACE
# TWILIO_AUTH_TOKEN=REPLACE
# TWILIO_PHONE_NUMBER=REPLACE

REDIS_URL=redis://redis:6379
ENABLE_SWAGGER=false
TRUST_PROXY=true
ENFORCE_HTTPS=true

IDENTITY_BASE_URL=https://identity.example/api/v1
IDENTITY_JWKS_URL=https://identity.example/api/v1/.well-known/jwks.json
# Must be set to cmi when NEXA_ENV=production (mock rejected; no silent default).
# CMI PreAuth + capture/void/refund — require secrets below.
STAYS_PAYMENT_PROVIDER=cmi
STAYS_PUBLIC_URL=https://stays.example
STAYS_WEB_URL=https://nexastays.example
# HMAC for signed messaging attachment/avatar URLs (required; do not reuse JWT private key)
MESSAGING_MEDIA_SECRET=REPLACE_LONG_RANDOM
CMI_CLIENT_ID=REPLACE_CMI_CLIENT_ID
CMI_STORE_KEY=REPLACE_CMI_STORE_KEY
CMI_CALLBACK_URL=https://stays.example/api/v1/stays/webhooks/payments/cmi
CMI_OK_URL=https://nexastays.example/en/bookings
CMI_FAIL_URL=https://nexastays.example/en/bookings
# CMI_API_URL=https://payment.cmi.co.ma/fim/api
# Host bank payout rails — leave false until settlement job is certified
STAYS_HOST_PAYOUT_ENABLED=false

# Required for NEXA_ENV=production (PROD-OPS-003)
ERROR_MONITORING_DSN=REPLACE_SENTRY_DSN
OPS_ALERT_WEBHOOK_URL=https://REPLACE_ALERT_WEBHOOK

# Platform
NOTIFICATIONS_SERVICE_URL=http://notifications:3003
MEDIA_SERVICE_URL=http://media:3004
IDENTITY_DISABLE_LOCAL_UPLOADS=true
PUSH_DISABLED=false

# Identity KYC + wallet gates (no silent sandbox/mock in production)
SUMSUB_MODE=live
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=  # must match Sumsub console webhook secret
# Webhook URL: https://identity.example/api/v1/kyc/sumsub/webhook
EMI_PROVIDER_TYPE=disabled
