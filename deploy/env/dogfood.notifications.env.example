# Notifications service (dogfood) — copy to deploy/.env.notifications (chmod 600)
PORT=3003
NODE_ENV=production
DB_HOST=identity-db
DB_PORT=5432
DB_USERNAME=nexa_identity
DB_PASSWORD=REPLACE_STRONG_PASSWORD
DB_NAME=nexa_identity
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
REDIS_URL=redis://redis:6379
INTERNAL_SERVICE_KEY=REPLACE_LONG_RANDOM
# Soft-launch: leave true until FCM service account is configured
PUSH_DISABLED=true
