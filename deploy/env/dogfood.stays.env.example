# Stays DB credentials for the stays container only.
# Copy to /opt/nexa/backend/deploy/.env.stays (chmod 600)
# MUST differ from Identity — shared single .env DB_* is unsafe.

DB_HOST=host.docker.internal
DB_PORT=5434
DB_USERNAME=nexa_stays
DB_PASSWORD=REPLACE_STRONG_PASSWORD
DB_NAME=nexa_stays

# Soft-launch payments — keep explicit on Stays env too
STAYS_PAYMENT_PROVIDER=mock
