# Dogfood / soft-launch SHARED env (NOT real-money production)
# On the VPS: copy to /opt/nexa/backend/deploy/.env  (chmod 600)
# Also create .env.identity and .env.stays from sibling examples.
#
# Soft-launch contract (required):
#   NODE_ENV=production  +  NEXA_ENV=dogfood  +  STAYS_PAYMENT_PROVIDER=mock
#
# Never commit real secrets. Never use latest tags.

NEXA_ENV=dogfood
NODE_ENV=production
IMAGE_REGISTRY=ghcr.io/REPLACE_OWNER
BACKEND_IMAGE_TAG=REPLACE_BACKEND_GIT_SHA
WEB_IMAGE_TAG=REPLACE_WEB_GIT_SHA
DASHBOARD_IMAGE_TAG=REPLACE_DASHBOARD_GIT_SHA
BUILD_VERSION=
BUILD_TIME=

# Host-published app ports (compose binds 127.0.0.1 only)
IDENTITY_HOST_PORT=3001
STAYS_HOST_PORT=3002

# Host-side migrate URLs (psql on the VPS → localhost published DB ports).
# Used by remote-deploy.sh → database/scripts/migrate-remote.sh
# Containers use host.docker.internal + .env.identity / .env.stays DB_* instead.
IDENTITY_DATABASE_URL=postgresql://nexa_identity:REPLACE_STRONG_PASSWORD@127.0.0.1:5433/nexa_identity
STAYS_DATABASE_URL=postgresql://nexa_stays:REPLACE_STRONG_PASSWORD@127.0.0.1:5434/nexa_stays

API_PREFIX=api/v1
DB_SYNCHRONIZE=false
# NODE_ENV=production requires DB_SSL=true; local VPS Postgres without TLS:
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

PII_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTE_KEY
JWT_PRIVATE_KEY=REPLACE_PEM
JWT_PUBLIC_KEY=REPLACE_PEM
JWT_KEY_ID=nexa-identity-1
JWT_EXPIRES_IN=15m
JWT_ADMIN_EXPIRES_IN=5m
JWT_ISSUER=https://identity.dogfood.example/api/v1
JWT_AUDIENCE=nexa-platform
REFRESH_TOKEN_PEPPER=REPLACE
OTP_PEPPER=REPLACE
KYC_HASH_PEPPER=REPLACE
ADMIN_PASSWORD_HASH=REPLACE_ARGON2ID
INTERNAL_SERVICE_KEY=REPLACE_LONG_RANDOM
CORS_ORIGINS=https://web.dogfood.example,https://admin.dogfood.example
# Shared refresh-cookie domain across identity + web + admin (leading dot).
AUTH_COOKIE_DOMAIN=.dogfood.example

# Twilio required when NODE_ENV=production (SEC-002).
# Dogfood may set DEMO_OTP_CODE for soft-launch OTP (forbidden when NEXA_ENV=production).
# DEMO_OTP_CODE=123456
# SMS — prefer EnvoiSMS for Morocco (+212). Twilio remains a fallback.
SMS_PROVIDER=envoisms
ENVOISMS_API_KEY=REPLACE
ENVOISMS_BASE_URL=https://api.envoisms.ma
# ENVOISMS_FROM=NexaStays
# TWILIO_ACCOUNT_SID=REPLACE
# TWILIO_AUTH_TOKEN=REPLACE
# TWILIO_PHONE_NUMBER=REPLACE

# Sumsub KYC — dogfood uses sandbox intentionally (production requires SUMSUB_MODE=live).
SUMSUB_MODE=sandbox
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# Webhook secret must match Sumsub console (not the API secret).
# SUMSUB_WEBHOOK_SECRET=
# Register: https://identity.<your-host>/api/v1/kyc/sumsub/webhook
# SUMSUB_LEVEL_NAME=basic-kyc-level

# Wallet top-up — mock allowed in dogfood (rejected when NEXA_ENV=production).
EMI_PROVIDER_TYPE=mock

# Host Redis published on 127.0.0.1:6379 — containers reach via host-gateway
REDIS_URL=redis://host.docker.internal:6379
ENABLE_SWAGGER=false
TRUST_PROXY=true

IDENTITY_BASE_URL=https://identity.dogfood.example/api/v1
IDENTITY_JWKS_URL=https://identity.dogfood.example/api/v1/.well-known/jwks.json
STAYS_PAYMENT_PROVIDER=mock
STAYS_PUBLIC_URL=https://stays.dogfood.example
STAYS_WEB_URL=https://web.dogfood.example

# Platform (required for events / push / media routing)
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:3003
MEDIA_SERVICE_URL=http://127.0.0.1:3004
NOTIFICATIONS_HOST_PORT=3003
MEDIA_HOST_PORT=3004
# Soft-launch: disable FCM until credentials are configured
PUSH_DISABLED=true
# PLATFORM_IMAGE_TAG=  # defaults to BACKEND_IMAGE_TAG when using GHCR images

# Observability — optional for dogfood (required only when NEXA_ENV=production)
# ERROR_MONITORING_DSN=
# OPS_ALERT_WEBHOOK_URL=

# Media — dogfood may use local disk on media-service (PROD-SEC-002).
# Do NOT set MEDIA_ALLOW_LOCAL_STORAGE when NEXA_ENV=production.