# Media service (dogfood) — copy to deploy/.env.media (chmod 600)
PORT=3004
NODE_ENV=production
NEXA_ENV=dogfood
MEDIA_STORAGE_BACKEND=local
# Durable path — compose mounts named volume media_data here (not /tmp)
MEDIA_STORAGE_ROOT=/data/nexa-media
# Internal Docker DNS is fine for dogfood — Stays proxies bytes to browsers.
# Prefer a public HTTPS origin once media.* is on the edge.
MEDIA_PUBLIC_BASE_URL=http://media:3004
MEDIA_SIGNING_SECRET=REPLACE_LONG_RANDOM
INTERNAL_SERVICE_KEY=REPLACE_LONG_RANDOM
# When NEXA_ENV=production: MEDIA_STORAGE_BACKEND=s3 + MEDIA_S3_BUCKET + https MEDIA_PUBLIC_BASE_URL
