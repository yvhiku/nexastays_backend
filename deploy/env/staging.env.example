# Staging environment contract (PROD-OPS-002)
# Copy to deploy/.env on the staging host. Placeholders only.

NEXA_ENV=staging
NODE_ENV=production
IMAGE_REGISTRY=ghcr.io/REPLACE_OWNER
IMAGE_TAG=REPLACE_GIT_SHA

DB_HOST=REPLACE_DB_HOST
DB_PORT=5432
DB_USERNAME=nexa_identity
DB_PASSWORD=REPLACE
DB_NAME=nexa_identity
DB_SYNCHRONIZE=false
DB_SSL=true
PII_ENCRYPTION_KEY=REPLACE_BASE64_32_BYTE_KEY

JWT_PRIVATE_KEY=REPLACE_PEM
JWT_PUBLIC_KEY=REPLACE_PEM
JWT_KEY_ID=nexa-identity-1
JWT_ISSUER=https://identity.staging.example/api/v1
JWT_AUDIENCE=nexa-platform
REFRESH_TOKEN_PEPPER=REPLACE
OTP_PEPPER=REPLACE
KYC_HASH_PEPPER=REPLACE
ADMIN_PASSWORD_HASH=REPLACE_ARGON2ID
INTERNAL_SERVICE_KEY=REPLACE
CORS_ORIGINS=https://web.staging.example,https://admin.staging.example

TWILIO_ACCOUNT_SID=REPLACE
TWILIO_AUTH_TOKEN=REPLACE
TWILIO_FROM_NUMBER=REPLACE

REDIS_URL=redis://REPLACE:6379
ENABLE_SWAGGER=false
TRUST_PROXY=true

IDENTITY_BASE_URL=https://identity.staging.example/api/v1
IDENTITY_JWKS_URL=https://identity.staging.example/api/v1/.well-known/jwks.json
# Staging mock only when explicitly set (no silent default at policy boundary):
STAYS_PAYMENT_PROVIDER=mock
STAYS_PUBLIC_URL=https://stays.staging.example
STAYS_WEB_URL=https://web.staging.example

# Used by database/scripts/migrate-remote.sh on the host (never commit real URLs)
# IDENTITY_DATABASE_URL=postgresql://nexa_identity:REPLACE@db-host:5432/nexa_identity
# STAYS_DATABASE_URL=postgresql://nexa_stays:REPLACE@db-host:5432/nexa_stays
