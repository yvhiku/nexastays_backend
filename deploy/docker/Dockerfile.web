FROM node:22-alpine AS build

ARG APP_DIR
ARG NEXT_PUBLIC_IDENTITY_API_BASE_URL
ARG NEXT_PUBLIC_STAYS_API_BASE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_STAYS_PAYMENT_PROVIDER=mock
ARG NEXT_PUBLIC_IDENTITY_API_URL
ARG NEXT_PUBLIC_STAYS_API_URL

ENV NEXT_PUBLIC_IDENTITY_API_BASE_URL=${NEXT_PUBLIC_IDENTITY_API_BASE_URL}
ENV NEXT_PUBLIC_STAYS_API_BASE_URL=${NEXT_PUBLIC_STAYS_API_BASE_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_STAYS_PAYMENT_PROVIDER=${NEXT_PUBLIC_STAYS_PAYMENT_PROVIDER}
ENV NEXT_PUBLIC_IDENTITY_API_URL=${NEXT_PUBLIC_IDENTITY_API_URL}
ENV NEXT_PUBLIC_STAYS_API_URL=${NEXT_PUBLIC_STAYS_API_URL}

WORKDIR /app
COPY ${APP_DIR}/package.json ${APP_DIR}/package-lock.json ./
RUN npm ci
COPY ${APP_DIR}/ ./
RUN npm run build

FROM node:22-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public

RUN addgroup -S nexa && adduser -S -G nexa nexa \
  && chown -R nexa:nexa /app
USER nexa

CMD ["npm", "start"]
