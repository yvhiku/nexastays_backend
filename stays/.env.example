# Nexa Stays — port 3002
# Copy to .env and fill values. Never commit .env.
PORT=3002
API_PREFIX=api/v1
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=nexa_stays
# Local docker-compose default only — use a strong unique password in production
DB_PASSWORD=nexa_stays_dev
DB_NAME=nexa_stays
DB_SYNCHRONIZE=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
PII_ENCRYPTION_KEY=

IDENTITY_BASE_URL=http://127.0.0.1:3001/api/v1
IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/v1/.well-known/jwks.json
# SEC-006: must match Identity JWT_ISSUER / JWT_AUDIENCE
JWT_ISSUER=http://127.0.0.1:3001/api/v1
JWT_AUDIENCE=nexa-platform

STAYS_PAYMENT_PROVIDER=mock
# Soft-launch: NODE_ENV=production + NEXA_ENV=dogfood + mock OK.
# Real NEXA_ENV=production rejects mock. Staging requires explicit mock. CMI is FUTURE.
# Legacy unauthenticated mock webhook — never set when NODE_ENV=production
# ALLOW_LEGACY_MOCK_WEBHOOK=true
STAYS_PUBLIC_URL=http://localhost:3002
STAYS_WEB_URL=http://localhost:3005

# CMI — server-only secrets; required when STAYS_PAYMENT_PROVIDER=cmi (FUTURE)
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_CALLBACK_URL=http://localhost:3002/api/v1/stays/webhooks/payments/cmi

# Include the web origin you actually use (nexastays_web often runs on :3005).
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3005,http://localhost:3005
# SEC-005 / PROD-OPS-002: development|dogfood|staging|production (dogfood/staging/production require CORS_ORIGINS)
# NEXA_ENV=development

REDIS_URL=redis://127.0.0.1:6379
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:3003
# Shared with platform services — use a long random value in production
INTERNAL_SERVICE_KEY=dev-internal-key

# Explore map: pin cap and max viewport span (degrees). Defaults handle Morocco-wide views.
# EXPLORE_MAP_PIN_MAX=1500
# EXPLORE_MAX_BOUNDS_SPAN_DEG=15

# Observability / incident routing
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
# PROD-OPS-003 — required when NEXA_ENV=production; optional for dogfood/staging/dev
# ERROR_MONITORING_DSN=https://<key>@o0.ingest.sentry.io/<project>
# OPS_ALERT_WEBHOOK_URL=https://hooks.example/alerts
# PAYMENT_ALERT_WEBHOOK_URL=https://hooks.example/payments
# ENABLE_OBSERVABILITY_TEST=true
# OPS_ALERT_EMAIL=ops@nexastays.com

# Abuse / secure deployment
# ENFORCE_BOT_PROTECTION=true
# ALLOW_SCRIPT_CLIENTS=false
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1
# ENFORCE_HTTPS=true
# ENABLE_SWAGGER=false
# SECURITY_AUTH_FAIL_BURST=20
# SECURITY_RATE_LIMIT_BURST=30
IDENTITY_SNAPSHOT_TTL_MS=120000

# Default platform fees (decimal). Overridden by stays_platform_settings after migration.
STAYS_GUEST_FEE_PCT=0.05
STAYS_HOST_FEE_PCT=0.05

# Post-stay messaging grace before auto-archive (hours after checkout).
POST_STAY_GRACE_HOURS=72
