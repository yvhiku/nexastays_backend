# Multi-stage production image for Nexa Identity (PROD-OPS-002).
# Do NOT copy .env into the image. Inject secrets at runtime.
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
# Default Identity port — override with PORT at runtime / compose.
ENV PORT=3001
ENV NEXA_SERVICE_NAME=nexa-identity

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist ./dist

RUN addgroup -g 1001 -S nodejs \
  && adduser -S nestjs -u 1001 \
  && chown -R nestjs:nodejs /app

USER nestjs

EXPOSE 3001

# Readiness probe: fails (non-zero) when HTTP status != 200 (DB down → 503).
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "const p=process.env.PORT||'3001';require('http').get('http://127.0.0.1:'+p+'/api/v1/health/ready',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "dist/main.js"]
